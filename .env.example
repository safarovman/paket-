# ─────────────────────────────────────────────
# GBoost Admin Panel — Environment Variables
# Bu faylni .env.local nomi bilan nusxalang
# ─────────────────────────────────────────────

# Gmail sozlamalari (OTP yuborish uchun)
# 1. Gmail → Settings → Security → 2-Step Verification → App passwords
# 2. App name: GBoost Admin
# 3. 16 ta belgili parolni bu yerga qo'ying

GMAIL_USER=sizning_gmail@gmail.com
GMAIL_PASS=xxxx xxxx xxxx xxxx

# Super Admin email (kirish uchun ishlatiladigan email)
SUPER_ADMIN_EMAIL=superadmin@gboost.uz

# Super Admin OTP qaysi emailga yuborilsin
# (shaxsiy Gmail manzilingiz)
SUPER_ADMIN_PERSONAL_EMAIL=sizning_shaxsiy@gmail.com

# ─────────────────────────────────────────────
# Vercel da qo'shish:
# Settings → Environment Variables → Add
# ─────────────────────────────────────────────
